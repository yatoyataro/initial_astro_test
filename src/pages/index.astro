---
import AppShell from '../components/layout/AppShell.astro';
import HomeSection from '../components/sections/HomeSection';
import ArchiveSection from '../components/sections/ArchiveSection';
import IntelSection from '../components/sections/IntelSection';
import UplinkSection from '../components/sections/UplinkSection';
import ClientInit from '../components/scripts/ClientInit';

// Import CSS so Astro bundles it
import '../styles/global.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/animations.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Dwight Jairo C. Pingul — Backend & Systems Software Engineer Portfolio" />
    <title>DWIGHT JAIRO C. PINGUL — TERMINAL PORTFOLIO</meta>
  </head>
  <body>
    <AppShell>
      <HomeSection slot="center" client:load />
      <ArchiveSection slot="center" client:load />
      <IntelSection slot="center" client:load />
      <UplinkSection slot="center" client:load />
    </AppShell>

    <ClientInit client:load />
  </body>
</html>