---
import { profile } from "@data/profile";
import pkg from "../../../package.json";

// Evaluated once, when the site is built (not in the visitor's browser).
const builtAt = new Date();
const buildDate = builtAt.toISOString().slice(0, 10).replaceAll("-", ".");
const year = builtAt.getUTCFullYear();
---

<footer class="bottom-footer">
  <span>BUILD_VERSION: {pkg.version}-STABLE</span>
  <span class="bottom-footer__build">LAST_BUILD: {buildDate}</span>
  <span>&copy; {year} {profile.name}</span>
</footer>
