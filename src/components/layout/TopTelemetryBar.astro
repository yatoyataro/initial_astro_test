<header class="top-bar" style="display: flex; align-items: center; justify-content: space-between; padding: 0 24px; height: 38px; font-size: 0.6875rem; letter-spacing: 0.08em;">
  <div style="display: flex; align-items: center; gap: 8px;">
    <span style="color: var(--text-secondary);">SYSTEM_INTEGRITY_CHECK //</span>
    <span style="color: var(--accent-blue); font-weight: 600;">PASSED</span>
  </div>
  <div style="display: flex; align-items: center; gap: 24px;">
    <div style="display: flex; align-items: center; gap: 6px;">
      <span style="color: var(--text-secondary);">OS:</span>
      <span style="color: var(--text-primary);">PROCESS_V1.0.4</span>
    </div>
    <div style="display: flex; align-items: center; gap: 6px;">
      <span style="color: var(--text-secondary);">CPU:</span>
      <span id="cpu-value" class="cpu-value" style="color: var(--text-primary);">0.4%</span>
    </div>
    <div style="display: flex; align-items: center; gap: 6px;">
      <span style="color: var(--text-secondary);">MEM:</span>
      <span style="color: var(--text-primary);">124MB</span>
    </div>
  </div>
  <div style="display: flex; align-items: center; gap: 8px;">
    <span id="live-clock" style="color: var(--text-secondary);">19:00:43</span>
  </div>
</header>