---
// Decorative "system status" strip. Hidden from assistive technology on purpose:
// the values are flavour text, not information. Layout is handled in layout.css (no inline styles).
---

<div class="top-bar" aria-hidden="true">
  <div class="top-bar__status">
    <span class="top-bar__label">
      <span class="show-md">SYSTEM_INTEGRITY_CHECK</span><span class="hide-md">SYS_CHECK</span> //
    </span>
    <span class="top-bar__ok">PASSED</span>
  </div>

  <div class="top-bar__stats">
    <div class="kv kv--os">
      <span class="kv__k">OS:</span>
      <span class="kv__v">PROCESS_V1.0.4</span>
    </div>
    <div class="kv">
      <span class="kv__k">CPU:</span>
      <span id="cpu-value" class="kv__v cpu-value">--%</span>
    </div>
    <div class="kv">
      <span class="kv__k">MEM:</span>
      <span class="kv__v">124MB</span>
    </div>
  </div>

  <span id="live-clock" class="top-bar__clock">--:--:--</span>
</div>
