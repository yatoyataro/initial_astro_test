---
import { ConsoleLog } from "../widgets/ConsoleLog";
import { NetworkTraffic } from "../widgets/NetworkTraffic";
import { TerminalBox } from "../widgets/TerminalBox";
import VisualId from "../widgets/VisualId.astro";
---

<!--
  Decorative diagnostics. aria-hidden keeps it out of the accessibility tree.
  Hidden below 768px (layout.css); client:media means phones never download or run its JavaScript.
-->
<div class="right-sidebar" aria-hidden="true">
  <TerminalBox title="VISUAL_ID" headingLevel={null}>
    <VisualId />
  </TerminalBox>

  <TerminalBox
    title="CONSOLE_OUTPUT.LOG"
    meta="BUFFER: 1024KB"
    variant="console"
    headingLevel={null}
  >
    <ConsoleLog client:media="(min-width: 768px)" />
  </TerminalBox>

  <TerminalBox title="NETWORK_TRAFFIC" headingLevel={null}>
    <NetworkTraffic client:media="(min-width: 768px)" />
  </TerminalBox>
</div>
