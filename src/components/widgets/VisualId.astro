<div class="visual-id">
  <svg
    width="96"
    height="64"
    viewBox="0 0 96 64"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <pattern id="visual-id-grid" patternUnits="userSpaceOnUse" width="2" height="2">
        <rect width="2" height="2" fill="currentColor" />
      </pattern>
    </defs>
    <!-- Outer ring: 96x64, 3-dot thick border -->
    <rect x="1.5" y="1.5" width="93" height="61" stroke="url(#visual-id-grid)" stroke-width="3" fill="none" color="#475569" />
    <!-- Middle ring: 60x38, centered, 2-dot thick -->
    <rect x="19" y="14" width="58" height="36" stroke="url(#visual-id-grid)" stroke-width="2" fill="none" color="#64748B" />
    <!-- Inner ring: 28x18, centered -->
    <rect x="35" y="24" width="26" height="16" stroke="url(#visual-id-grid)" stroke-width="1" fill="none" color="#94A3B8" />
    <!-- Center dot -->
    <rect x="47" y="31" width="2" height="2" fill="#94A3B8" />
  </svg>
</div>
